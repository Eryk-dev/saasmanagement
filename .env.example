# Cockpit — variáveis de ambiente.
# Copie para `.env` na raiz: API e MCP leem esse arquivo. O Vite NÃO lê a raiz —
# as VITE_* do bloco "Web" vão em `packages/web/.env` (ou no ambiente do build).
#
# Regra geral: integração sem credencial fica DESLIGADA graciosamente — a API
# sobe e as telas mostram o passo de configuração. Para desenvolvimento local,
# preencha só o bloco "Essencial" e deixe o resto vazio: a API executa migrações
# e rotinas em segundo plano no boot, e uma credencial real aqui faz o ambiente
# local conversar com serviços de produção (pagamentos, WhatsApp, anúncios…).

# ════════════════════════════════════════════════════════════════════
# Essencial
# ════════════════════════════════════════════════════════════════════

# ── API (packages/api) ─────────────────────────────────────────────
# Porta em que a API REST escuta.
API_PORT=8787

# Banco Postgres (Supabase). OBRIGATÓRIO. A API cria sozinha o schema `cockpit`
# e as tabelas no primeiro boot.
#
# Local (infra/local/docker-compose.yml — ver README):
#   postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable
# Supabase na nuvem (Settings → Database → Connection string, use o pooler):
#   postgresql://postgres.<ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:6543/postgres?sslmode=require
#
# NUNCA aponte um ambiente local para o banco de produção.
COCKPIT_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable

# Chave mestre. Se definida, TODA rota da API exige autenticação (leituras E
# escritas), via `x-api-key: <valor>` ou `Authorization: Bearer <valor>` — com
# esta chave (integrações, MCP) ou com o token de sessão de um usuário logado
# (a UI). Ficam abertas só as superfícies públicas (/api/health, login, /f/, /p/,
# /public/*, webhooks…). Vazia = API toda aberta e sem login de usuário; em
# local, prefira definir um valor qualquer para testar o fluxo real de login.
COCKPIT_API_KEY=

# Base pública das URLs geradas pelo app (links de form/proposta gravados no
# lead, back_url do checkout do Mercado Pago, blog). Em produção, o domínio.
COCKPIT_PUBLIC_URL=
# Base dos links de NPS enviados ao cliente. Vazio = deriva do host da request.
PUBLIC_BASE_URL=

# ── Servidor MCP (packages/mcp) ────────────────────────────────────
# Porta do servidor MCP Streamable-HTTP (endpoint: POST /mcp, health em /health).
MCP_PORT=8788
# URL base que o servidor MCP usa para alcançar a API.
COCKPIT_API_URL=http://localhost:8787
# Auth do endpoint /mcp. Vazio = cai no COCKPIT_API_KEY (a mesma chave protege
# API + MCP).
# MCP_AUTH_KEY=
# Chave que o MCP usa AO CHAMAR a API. Vazio = cai no COCKPIT_API_KEY.
# MCP_API_KEY=

# ── Web (packages/web) — lidas de packages/web/.env, não deste arquivo ─
# Em dev, o Vite faz proxy de /api, /f, /p, /public e /embed.js para a API:
# deixe vazio. Para um build apontando para uma API remota, defina a URL base.
# VITE_API_BASE=
# Chave pré-preenchida na UI. SÓ para dev: entra no bundle JS, nunca use em build
# de produção.
# VITE_API_KEY=
# Destino do proxy do Vite em dev (padrão http://localhost:8787). Variável do
# processo: defina no shell ao rodar `npm run dev:web`.
# API_TARGET=

# ════════════════════════════════════════════════════════════════════
# Integrações (opcionais — vazias = desligadas)
# ════════════════════════════════════════════════════════════════════

# ── IA (resumos de call, SDR, copiloto, blog, sugestões) ───────────
# Uma chave basta. `sk-or-…` usa OpenRouter; senão, Anthropic direto.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Modelo (vazio = default do código para o provedor detectado).
AI_MODEL=
# Alias antigo de AI_MODEL.
# ANTHROPIC_MODEL=
# Modelo de visão do copiloto de call (via OpenRouter).
# COPILOT_VISION_MODEL=google/gemini-2.5-flash-lite
# Leitura de custos de IA (tela de custos). Exigem chaves ADMIN dos provedores.
# OPENAI_ADMIN_KEY=
# ANTHROPIC_ADMIN_KEY=

# ── Transcrição de ligação ─────────────────────────────────────────
# A ligação do WhatsApp feita pelo cockpit é gravada no navegador e transcrita
# aqui. Por padrão usa a OPENROUTER_API_KEY (modelo de áudio do Gemini, bem mais
# barato que o Whisper). Sem nenhuma chave de IA a ligação funciona, só não gera
# transcrição nem resumo. Alternativa: Whisper da OpenAI.
# OPENAI_API_KEY=
# TRANSCRIBE_PROVIDER=openrouter   # openrouter (default) | openai
# TRANSCRIBE_MODEL=google/gemini-2.5-flash-lite
# TRANSCRIBE_API_KEY=              # chave dedicada só para transcrição (OpenAI)

# ── WhatsApp Cloud API (Inbox, cadências, SDR) ─────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WABA (conta do WhatsApp Business): templates, saúde e custos. Vazio = o app
# tenta descobrir pelo número.
WHATSAPP_WABA_ID=
# Token de verificação do webhook (/api/webhooks/…). Também serve para o webhook
# de comentários da Meta quando META_WEBHOOK_VERIFY_TOKEN estiver vazio.
WHATSAPP_VERIFY_TOKEN=
# Horas de silêncio nosso até avisar o responsável pelo lead (padrão 3).
# WA_WAITING_HOURS=3

# ── Mercado Pago (financeiro — assinaturas + espelho de pagamentos) ─
# Access token da aplicação MP (produção ou sandbox). Vazio = integração
# desligada (botão "cobrar via MP" não aparece). Só com o token o cockpit já
# espelha os pagamentos da conta (poller de 10 min, backfill de 400 dias no 1º
# boot), casa com clientes/faturas e gera link de cobrança avulsa.
MERCADOPAGO_ACCESS_TOKEN=
# Secret do webhook (painel MP → Webhooks → Configurações avançadas).
# URL do webhook no painel: https://<host>/public/mp/webhook
# Vazio = assinatura NÃO verificada (ok em sandbox; em produção defina sempre).
MERCADOPAGO_WEBHOOK_SECRET=
# Carência do dunning em dias (fatura aberta vira overdue após vencimento +
# carência; assinatura com overdue vira past_due). Vazio = 3.
BILLING_GRACE_DAYS=

# ── LeverAds (produto copylever) — sync de acesso por pagamento ────
# O cockpit liga/corta o paywall das orgs do produto (payment_active, via API
# super-admin do produto) conforme o billing daqui: assinatura em dia libera,
# past_due corta. Só toca orgs mapeadas (customer.leveradsOrgId).
# Sem email/senha = sync desligado.
LEVERADS_API_URL=https://copy.levermoney.com.br
LEVERADS_ADMIN_EMAIL=
LEVERADS_ADMIN_PASSWORD=
# Sem "1", o sync roda em DRY-RUN: só reporta o que faria (revisar em
# GET /api/leverads-access/status ou forçar com POST /api/leverads-access/run).
# NUNCA use "1" fora de produção.
LEVERADS_ACCESS_APPLY=

# ── Levercopy (propostas e resultados de clientes) ─────────────────
# Ao criar um lead manual do SaaS Levercopy sem template nativo, o Cockpit pede a
# proposta ao Levercopy (POST {LEVERCOPY_API_URL}/api/proposta/generate, header
# X-Cockpit-Key) e grava proposta_id/proposalUrl/proposal_edit_url no lead.
# Sem LEVERCOPY_INGEST_KEY a integração fica desligada.
LEVERCOPY_API_URL=https://leverads.com.br
# Deve bater com a COCKPIT_INGEST_KEY configurada no Levercopy.
LEVERCOPY_INGEST_KEY=
# id do produto (campo `saas` do lead) que representa o Levercopy.
LEVERCOPY_SAAS_ID=leverads
# Banco do Levercopy para os resultados reais no deck da proposta (só leitura).
# Vazio = consulta o schema `public` do próprio COCKPIT_DB_URL; se as funções do
# Levercopy não existirem (ex.: banco local), o slide cai no texto do template.
LEVERCOPY_DB_URL=
# Org ids (separados por vírgula) fora dos resultados agregados.
# LEVERADS_PORTFOLIO_EXCLUDE=00000000-0000-0000-0000-000000000001

# ── Elo App (workspace "elo") ──────────────────────────────────────
# Connection string da role read-only `cockpit_reader` no projeto Supabase do
# Elo (session pooler). Vazio = tela "Análise do App" mostra o passo de config.
ELO_DB_URL=

# ── Meta (anúncios, redes sociais, Pixel/CAPI) ─────────────────────
# Token longo de system user com as permissões de cada funcionalidade:
#   insights de anúncios     ads_read
#   métricas do perfil       instagram_basic, instagram_manage_insights,
#                            pages_read_engagement, read_insights
#   publicar                 instagram_content_publish, pages_manage_posts
#   comentários (IG)         instagram_manage_comments
#   comentários (página FB)  pages_manage_engagement, pages_read_user_content
# A conta de anúncio (act_…) é POR SAAS: Configurações → Integrações.
META_ACCESS_TOKEN=
# Verificação do webhook de comentários (callback https://SEU_DOMINIO/api/webhooks/social).
# Vazio = cai no WHATSAPP_VERIFY_TOKEN (mesmo app da Meta). Sem nenhum dos dois,
# os comentários só aparecem na varredura ao abrir a tela.
META_WEBHOOK_VERIFY_TOKEN=
# Pixel da página pública de formulário (/f/:id). Vazio = default do código.
META_PIXEL_ID=
# Conversions API: "Lead" server-side deduplicado com o Pixel. Token nível-senha,
# NUNCA no frontend. Vazio = CAPI desligado (o Pixel continua funcionando).
META_CAPI_ACCESS_TOKEN=
# Test Event Code — só para validar; vazio em produção.
META_TEST_EVENT_CODE=

# ── Google (Agenda, Meet, Docs de transcrição) ─────────────────────
# App OAuth usado pela conta do time e pelas contas pessoais dos usuários.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Calendário onde ficam as calls (padrão "primary").
# GOOGLE_MEET_CALENDAR_ID=primary

# ── Shopify (loja UniqueKids — pedidos pagos viram leads) ──────────
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=
# Secret HMAC do webhook orders/paid (o específico da UniqueKids tem prioridade).
SHOPIFY_WEBHOOK_SECRET=
# SHOPIFY_WEBHOOK_SECRET_UNIQUEKIDS=
# Piso do total do pedido para gerar lead (padrão 0).
# SHOPIFY_UNIQUEKIDS_MIN=0

# ── Linear (espelho dos tickets de suporte ↔ issues) ───────────────
# Chave da API (Linear → Settings → Security & access → Personal API keys).
# Vazia = espelho desligado: nenhum ticket vira issue e a tela de Configurações
# de SLA mostra o passo que falta. O time/projeto de cada produto é escolhido
# na tela (Suporte → Configurações de SLA → Linear), não aqui.
LINEAR_API_KEY=
# Segredo do webhook (Linear → Settings → API → Webhooks; eventos Issues e
# Comments, URL <domínio>/api/webhooks/linear). Sem ele a rota RECUSA as
# entregas e a volta do Linear só chega pela reconciliação (a cada 10 min).
LINEAR_WEBHOOK_SECRET=

# ── Discord (avisos do funil: lead novo, proposta, pagamento) ──────
DISCORD_WEBHOOK_URL=

# ── Blog público (routes.blog-public.js) ───────────────────────────
# O cockpit RENDERIZA o blog em /public/blog/*; o copylever faz proxy de
# leverads.com.br/blog para cá. Base pública das URLs (canonical, OG, sitemap):
BLOG_PUBLIC_URL=https://leverads.com.br/blog
# Segredo compartilhado com o copylever (BLOG_PROXY_TOKEN lá). Só a request com
# `x-blog-proxy: <token>` recebe HTML indexável; sem token tudo sai noindex.
BLOG_PROXY_TOKEN=
# Segredo do link de preview de rascunho (vazio = usa COCKPIT_API_KEY).
# BLOG_PREVIEW_SECRET=
# Form de diagnóstico usado nos CTAs dos posts (UTMs entram sozinhas).
# BLOG_FORM_URL=https://levermoney.com.br/f/fo_diagnostico_leverads

# ════════════════════════════════════════════════════════════════════
# Ajustes finos (opcionais — os padrões do código atendem)
# ════════════════════════════════════════════════════════════════════

# Cache de listagem do repositório ("0" desliga).
# COCKPIT_LIST_CACHE=1
# Limites por IP das superfícies públicas (requisições por janela).
# FORM_RATE_LIMIT=10
# FORM_EVENT_RATE_LIMIT=60
# LP_EVENT_RATE_LIMIT=60
# PROPOSAL_RATE_LIMIT=30
# Horários (São Paulo) das rotinas diárias.
# TASK_REMINDER_HOUR=8
# TRAINING_REMINDER_HOUR=9
# CUSTOMER_REPORT_HOUR=9
# COMP_CLOSE_HOUR=6
